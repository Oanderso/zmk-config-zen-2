#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;

        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        TEXT {
            display-name = "DVORAK";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp SQT   &kp COMMA  &kp DOT  &kp P      &kp Y       &kp F    &kp G      &kp C        &kp R  &kp L  &kp FSLH
&kp TAB    &kp A     &kp O      &kp E    &kp U      &kp I       &kp D    &kp H      &kp T        &kp N  &kp S  &mo 1
&kp LCTRL  &kp SEMI  &kp Q      &kp J    &kp K      &kp X       &kp B    &kp M      &kp W        &kp V  &kp Z  &kp DEL
                                &mo 2    &kp SPACE  &kp BSPC    &kp RET  &kp RSHFT  &kp LG(TAB)
            >;
        };

        SYMBOL {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |Studio|
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE   &kp N1        &kp N2        &kp N3        &kp N4        &kp N5       &kp N6     &kp N7    &kp N8    &kp N9  &kp N0  &kp BACKSLASH
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp HOME     &kp END    &trans    &trans    &trans  &trans  &trans
&kp RCTRL   &kp LEFT_ALT  &trans        &trans        &kp LBKT      &kp MINUS    &kp EQUAL  &kp RBKT  &trans    &trans  &trans  &kp DELETE
                                        &kp LGUI      &trans        &kp SPACE    &kp RET    &trans    &kp RALT
            >;
        };

        NAVI {
            display-name = "NAVI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kt LC(Z)        &kp LC(C)  &kp UP    &kp LC(V)  &kp LC(EQUAL)  &kp C_VOL_UP    &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &rgb_ug RGB_HUI  &kp BSPC
&kp LC(Y)        &kp LEFT   &kp DOWN  &kp RIGHT  &kp LC(MINUS)  &kp C_VOL_DN    &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &rgb_ug RGB_HUD  &trans
&kp PRINTSCREEN  &mkp MB1   &mkp MB3  &mkp MB2   &mkp MB4       &mkp MB5        &msc SCRL_LEFT   &msc SCRL_RIGHT  &trans           &trans           &rgb_ug RGB_TOG  &trans
                                      &trans     &trans         &trans          &trans           &trans           &trans
            >;
        };
    };
};
